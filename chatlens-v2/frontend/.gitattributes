# Line ending enforcements
* text=auto eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Linguist overrides for accurate GitHub repo language stats
*.css linguist-detectable=false
*.mjs linguist-language=TypeScript
docs/** linguist-documentation
scripts/** linguist-vendored=false
*.test.ts linguist-detectable=false
