# ==============================================================================
# KL-Sync Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT: NEVER commit .env.local or actual secrets to Git!
# In production, set these via Vercel Dashboard: Settings -> Environment Variables.
# ==============================================================================

# --- REQUIRED IN PRODUCTION ---

# AES-256-GCM encryption secret for student ERP sessions.
# Generate a secure 32+ character hex string:
#   openssl rand -hex 32
SESSION_SECRET=

# --- OPTIONAL: AI COPILOT ---

# OpenAI API key for the context-aware AI Chat Assistant.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- OPTIONAL: CAPTCHA AUTO-SOLVER ---

# OCR.space API key for server-side captcha OCR fallback.
# Free key at: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=

# --- OPTIONAL: BOT PROTECTION ---

# CapJS proof-of-work challenge verification secret.
CAP_SECRET=

# --- OPTIONAL: RATE LIMITING ---

# Upstash Redis for distributed rate limiting across edge functions.
# Dashboard: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OPTIONAL: PROXY HEADERS ---

# Set to 'true' to trust X-Forwarded-For / X-Real-IP for rate limiting.
# Auto-enabled on Vercel (VERCEL=1). Required for correct IP extraction
# behind any reverse proxy.
TRUST_PROXY_HEADERS=
