# Repository-wide EditorConfig defaults
root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,mjs,json,yml,yaml,toml,css,html,md}]
indent_size = 2

[Makefile]
indent_style = tab
