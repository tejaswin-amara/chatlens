# SPARK PA Daemon Settings
TELEGRAM_API_ID="123456"
TELEGRAM_API_HASH="hash"
TELEGRAM_SESSION_STRING="string"

GOOGLE_CREDENTIALS_BASE64="ey...="
GOOGLE_CALENDAR_ID="primary"
GOOGLE_SHEET_ID="doc_id"

# Gemini API Settings (Supports Gemini Pro via Jio / Google AI Studio)
GEMINI_API_KEY="AI..."
GEMINI_MODEL="gemini-3.5-flash-lite" # Or "gemini-1.5-pro" for high-capacity reasoning
GEMINI_DAILY_BUDGET=50

SPARK_MODE="dry"
SPARK_CHAT_IDS="-100123456789"
SPARK_DB="spark.db"
SPARK_MEDIA=false
SPARK_TIMETABLE="data/timetable_T04.toml"

LOG_LEVEL="INFO"
# SENTRY_DSN=""

# BOT_TOKEN=""
# OWNER_CHAT_ID=123456

# Firebase Spark Plan & Frontend Settings
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="chatlens-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="chatlens-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="chatlens-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="false"
# FIREBASE_CREDENTIALS_PATH="/path/to/firebase-service-account.json"

# Database & Celery (Optional for full-text vector backend)
DATABASE_URL="postgresql://user:pass@localhost:5432/chatlens"
CELERY_BROKER_URL="redis://localhost:6379/0"

