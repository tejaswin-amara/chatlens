# ==============================================================================
# ChatLens v2 & SPARK PA Daemon — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.production on the production host:
#   cp .env.production.example .env
#
# Replace all <CHANGE_ME_*> and placeholder values with genuine production secrets.
# NEVER commit real passwords, API keys, or session strings into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reverse Proxy & Domain / SSL Orchestration (Caddy)
# ------------------------------------------------------------------------------
# Domain name for TLS certificate automation via Let's Encrypt / ZeroSSL
DOMAIN=chatlens.example.com
DOMAIN_NAME=chatlens.example.com
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 2. PostgreSQL & pgvector Database
# ------------------------------------------------------------------------------
POSTGRES_USER=chatlens
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_RANDOM_POSTGRES_PASSWORD>
POSTGRES_DB=chatlens
DATABASE_URL=postgresql+asyncpg://chatlens:<CHANGE_ME_STRONG_RANDOM_POSTGRES_PASSWORD>@postgres:5432/chatlens

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Google Gemini Generative AI API
# ------------------------------------------------------------------------------
# AI Studio API Key for residual classification and unstructured text extraction
GEMINI_API_KEY=<GOOGLE_AI_STUDIO_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_BUDGET=50

# ------------------------------------------------------------------------------
# 5. SPARK PA Daemon Settings (KLEF Academic Assistant)
# ------------------------------------------------------------------------------
# Invariant: Telegram is strictly read-only.
# Operational mode: dry (audit only), confirm (owner bot approval), or live (auto-write verified changes)
SPARK_MODE=confirm
# Allowlist of monitored Telegram chat IDs (comma-separated; refuses to start if empty)
SPARK_CHAT_IDS="-1001234567890,-1009876543210"
# Persistent SQLite database path in container (must point to persistent /app/data volume)
SPARK_DB=/app/data/spark.db
# Enable media OCR/transcription downloads if true (default: false)
SPARK_MEDIA=false
# Timetable TOML configuration file path
SPARK_TIMETABLE=data/timetable_T04.toml
# Logging verbosity (DEBUG, INFO, WARNING, ERROR) - PII is only logged at DEBUG
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 6. Telegram MTProto User Client (Telethon)
# ------------------------------------------------------------------------------
# API credentials obtained from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=<32_CHARACTER_HEX_TELEGRAM_API_HASH>
# Telethon StringSession (generate via: uv run python scripts/generate_session.py)
TELEGRAM_SESSION_STRING=<BASE64_TELETHON_STRING_SESSION>

# ------------------------------------------------------------------------------
# 7. Telegram Private Owner Bot
# ------------------------------------------------------------------------------
# Bot token created via @BotFather for sending alerts and inline /undo approval
BOT_TOKEN=<TELEGRAM_BOTFATHER_BOT_TOKEN>
# Owner Telegram User ID receiving notifications
OWNER_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 8. Google Workspace Integration (Calendar & Sheets)
# ------------------------------------------------------------------------------
# Base64-encoded Service Account or OAuth credentials JSON
# Generate via: uv run python scripts/google_token.py
GOOGLE_CREDENTIALS_BASE64=<BASE64_ENCODED_GOOGLE_SERVICE_ACCOUNT_JSON>
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEET_ID=<GOOGLE_SHEET_SPREADSHEET_ID>

# ------------------------------------------------------------------------------
# 9. Application Limits & Observability (Optional)
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (default: 50MB = 52428800)
MAX_UPLOAD_BYTES=52428800
# Optional Sentry DSN for error monitoring
# SENTRY_DSN=https://<public_key>@o0.ingest.sentry.io/<project_id>


# Firebase authentication for the ChatLens web platform.
NEXT_PUBLIC_FIREBASE_API_KEY=<FIREBASE_WEB_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<FIREBASE_PROJECT_ID>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<FIREBASE_STORAGE_BUCKET>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<FIREBASE_MESSAGING_SENDER_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=<FIREBASE_WEB_APP_ID>
NEXT_PUBLIC_REQUIRE_AUTH=true

ENVIRONMENT=production
REQUIRE_AUTH=true
CHATLENS_ALLOWED_EMAILS=owner@example.com
FIREBASE_ADMIN_CREDENTIALS_FILE=./secrets/firebase-admin.json
